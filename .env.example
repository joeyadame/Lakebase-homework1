# Copy this file to .env for local development.
# Do not commit real credentials.

LAKEBASE_URL=

LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

# Alternative OAuth-token style local config. Leave PGPASSWORD blank and run:
# python get_lakebase_password.py --format env
PGHOST=
PGDATABASE=databricks_postgres
PGUSER=
PGPORT=5432
PGSSLMODE=require
ENDPOINT_NAME=
